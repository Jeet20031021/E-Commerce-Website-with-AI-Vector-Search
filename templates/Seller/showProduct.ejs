<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Dashboard | LuminaCommerce</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            500: '#14b8a6',
                            600: '#0d9488',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Smooth transitions for the accordion menu */
        .submenu-transition {
            transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
            max-height: 0;
            opacity: 0;
            overflow: hidden;
        }
        .submenu-open {
            max-height: 500px; /* Arbitrary large value to allow content to fit */
            opacity: 1;
        }
    </style>
</head>
<body class="bg-gray-100 font-sans text-gray-900 antialiased overflow-hidden">
    
    <!-- Main Flex Container (100vh) -->
    <div class="flex h-screen w-full">

        <!-- Mobile Overlay -->
        <div id="sidebar-overlay" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-20 hidden md:hidden transition-opacity"></div>

        <!-- Sidebar -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-30 w-64 bg-gray-900 text-gray-300 flex flex-col transform -translate-x-full md:translate-x-0 md:static md:flex-shrink-0 transition-transform duration-300 ease-in-out h-full shadow-2xl md:shadow-none">
            
            <!-- Seller Profile Header -->
            <div class="h-16 flex items-center px-6 bg-gray-950 border-b border-gray-800">
                <div class="flex items-center space-x-3 w-full">
                    <div class="h-8 w-8 rounded-full bg-brand-500 flex items-center justify-center text-white font-bold flex-shrink-0">
                        S
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-sm font-medium text-white truncate" title="seller@example.com"><%=name%></p>
                        <p class="text-xs text-brand-500">Verified Seller</p>
                    </div>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 overflow-y-auto py-4">
                <ul class="space-y-1">
                    
                    <!-- Add Product -->
                    <li>
                        <a href="/seller/dashboard/addproduct" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors group">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-brand-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            <span class="font-medium">Add Product</span>
                        </a>
                    </li>

                    <!-- Show Products -->
                    <li>
                        <a href="/seller/dashboard/show/product" class="flex items-center px-6 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors group">
                            <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-brand-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                            </svg>
                            <span class="font-medium">Show Products</span>
                        </a>
                    </li>

                    <!-- Settings (Accordion) -->
                    <li>
                        <button id="settings-btn" class="w-full flex items-center justify-between px-6 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors group focus:outline-none">
                            <div class="flex items-center">
                                <svg class="h-5 w-5 mr-3 text-gray-400 group-hover:text-brand-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                                <span class="font-medium">Settings</span>
                            </div>
                            <svg id="settings-chevron" class="h-4 w-4 text-gray-400 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        
                        <!-- Sub-menu -->
                        <ul id="settings-submenu" class="submenu-transition bg-gray-950">
                            <li>
                                <a href="#" class="block pl-14 pr-6 py-2.5 text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                                    Update Address
                                </a>
                            </li>
                            <li>
                                <a href="#" class="block pl-14 pr-6 py-2.5 text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                                    Change Password
                                </a>
                            </li>
                            <li>
                                <a href="#" class="block pl-14 pr-6 py-2.5 text-sm text-gray-400 hover:text-white hover:bg-gray-800 transition-colors">
                                    Set Profile Image
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </nav>
            
            <!-- Sidebar Footer (Optional) -->
            <div class="p-4 bg-gray-950 text-xs text-gray-500 text-center">
                &copy; 2026 LuminaCommerce
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="flex-1 flex flex-col min-w-0 bg-gray-100">
            
            <!-- Top Navbar -->
            <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-4 sm:px-6 z-10 flex-shrink-0">
                
                <!-- Left Side: Hamburger & Brand -->
                <div class="flex items-center">
                    <button id="mobile-menu-btn" class="text-gray-500 hover:text-gray-700 focus:outline-none md:hidden mr-4">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    
                    <div class="flex items-center space-x-2">
                        <svg class="w-6 h-6 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                        </svg>
                        <span class="text-lg font-bold text-gray-900 tracking-wide hidden sm:block">LuminaCommerce</span>
                        <span class="text-lg font-bold text-gray-900 tracking-wide sm:hidden">Lumina</span>
                    </div>
                </div>

                <!-- Right Side: Logout Anchor -->
                <div>
                    <a href="/seller/logout" class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-red-600 bg-red-50 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors">
                        <svg class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                        Logout
                    </a>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8">
                
                <!-- Page Header (Optional, for context) -->
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
                    <p class="text-sm text-gray-500">Welcome back to your LuminaCommerce seller portal.</p>
                </div>

                <!-- Show Products Component Container -->
<div class="w-full bg-white rounded-xl border border-gray-100 shadow-sm p-4 sm:p-6 lg:p-8">
    
    <!-- Header & Search Toolbar -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">Product Inventory</h2>
            <p class="text-sm text-gray-500 mt-1">Manage your existing catalog, view stock levels, and update listings.</p>
        </div>
        
        <!-- Search Box -->
        <div class="w-full sm:w-80 relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <input type="text" id="search-product" 
                class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg bg-gray-50 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition-all sm:text-sm"
                placeholder="Search by product name...">
        </div>
    </div>

    <!-- Responsive Table Wrapper -->
    <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        Product Name
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        Price
                    </th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        Quantity
                    </th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody id="product-table-body" class="bg-white divide-y divide-gray-200">
                <!-- Rows will be injected here by JavaScript -->
            </tbody>
        </table>
    </div>

    <!-- Empty State (Shown when search has no results) -->
    <div id="empty-state" class="hidden flex-col items-center justify-center py-12 px-4 text-center">
        <svg class="h-12 w-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-900">No products found</h3>
        <p class="text-sm text-gray-500 mt-1">Try adjusting your search terms.</p>
    </div>
</div>
            </main>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            // DOM Elements
            const sidebar = document.getElementById('sidebar');
            const sidebarOverlay = document.getElementById('sidebar-overlay');
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            
            const settingsBtn = document.getElementById('settings-btn');
            const settingsSubmenu = document.getElementById('settings-submenu');
            const settingsChevron = document.getElementById('settings-chevron');

            // --- Mobile Sidebar Toggle Logic ---
            function toggleSidebar() {
                const isOpen = !sidebar.classList.contains('-translate-x-full');
                
                if (isOpen) {
                    // Close sidebar
                    sidebar.classList.add('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden'); // Restore body scroll
                } else {
                    // Open sidebar
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.remove('hidden');
                    // Prevent body scroll on mobile when sidebar is open
                    if (window.innerWidth < 768) {
                        document.body.classList.add('overflow-hidden'); 
                    }
                }
            }

            mobileMenuBtn.addEventListener('click', toggleSidebar);
            sidebarOverlay.addEventListener('click', toggleSidebar);

            // Close sidebar on window resize if moving to desktop view
            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768) {
                    sidebar.classList.remove('-translate-x-full');
                    sidebarOverlay.classList.add('hidden');
                    document.body.classList.remove('overflow-hidden');
                } else {
                    sidebar.classList.add('-translate-x-full');
                }
            });

            // --- Accordion Logic ---
            settingsBtn.addEventListener('click', () => {
                const isExpanded = settingsSubmenu.classList.contains('submenu-open');
                
                if (isExpanded) {
                    // Close Accordion
                    settingsSubmenu.classList.remove('submenu-open');
                    settingsChevron.style.transform = 'rotate(0deg)';
                } else {
                    // Open Accordion
                    settingsSubmenu.classList.add('submenu-open');
                    settingsChevron.style.transform = 'rotate(180deg)';
                }
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
    
    // 1. Dummy Raw Data to demonstrate the layout
    // In production, you would fetch this array from your Elasticsearch/Node.js backend
    let products = [
        { 
            id: 'prod_001', 
            name: 'Wireless Noise-Cancelling Headphones', 
            category: 'Electronic',
            price: 249.99, 
            quantity: 45, 
            image: 'https://placehold.co/150x150/f3f4f6/6b7280?text=Audio' 
        },
        { 
            id: 'prod_002', 
            name: 'Hydrating Face Serum with Hyaluronic Acid', 
            category: 'Cosmetic',
            price: 34.50, 
            quantity: 120, 
            image: 'https://placehold.co/150x150/f3f4f6/6b7280?text=Serum' 
        },
        { 
            id: 'prod_003', 
            name: 'Mechanical Gaming Keyboard (Red Switches)', 
            category: 'Electronic',
            price: 129.00, 
            quantity: 0, 
            image: 'https://placehold.co/150x150/f3f4f6/6b7280?text=Kybd' 
        },
        { 
            id: 'prod_004', 
            name: 'Educational Building Blocks Set', 
            category: 'Toys',
            price: 45.99, 
            quantity: 32, 
            image: 'https://placehold.co/150x150/f3f4f6/6b7280?text=Toys' 
        }
    ];

    const tableBody = document.getElementById('product-table-body');
    const searchInput = document.getElementById('search-product');
    const emptyState = document.getElementById('empty-state');
    const tableWrapper = document.querySelector('.overflow-x-auto');

    // 2. Render Table Function
    function renderTable(dataToRender) {
        tableBody.innerHTML = ''; // Clear existing rows

        if (dataToRender.length === 0) {
            tableWrapper.classList.add('hidden');
            emptyState.classList.remove('hidden');
            emptyState.classList.add('flex');
            return;
        }

        tableWrapper.classList.remove('hidden');
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');

        dataToRender.forEach(product => {
            // Determine stock status for UI styling
            const inStock = product.quantity > 0;
            const stockBadge = inStock 
                ? `<span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">In Stock</span>`
                : `<span class="px-2.5 py-0.5 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Out of Stock</span>`;

            // Create table row
            const row = document.createElement('tr');
            row.className = 'hover:bg-gray-50 transition-colors';
            
            row.innerHTML = `
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 h-10 w-10">
                            <img class="h-10 w-10 rounded-md object-cover border border-gray-200" src="${product.image}" alt="">
                        </div>
                        <div class="ml-4 max-w-[200px] sm:max-w-xs md:max-w-sm overflow-hidden">
                            <div class="text-sm font-medium text-gray-900 truncate" title="${product.name}">
                                ${product.name}
                            </div>
                            <div class="text-sm text-gray-500">
                                ${product.category}
                            </div>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">$${product.price.toFixed(2)}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900 font-medium">${product.quantity} units</div>
                    <div class="mt-1">${stockBadge}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button onclick="editProduct('${product.id}')" class="text-blue-600 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 p-2 rounded-md transition-colors inline-flex mr-2" title="Edit">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    </button>
                    <button onclick="deleteProduct('${product.id}')" class="text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 p-2 rounded-md transition-colors inline-flex" title="Delete">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                </td>
            `;
            tableBody.appendChild(row);
        });
    }

    // 3. Initial Render
    renderTable(products);

   const response = await fetch("/seller/dashboard/fetch/products", {
        method: "GET",
        headers: {
            "Accept": "application/json",
        }
    });

    const res = response.json();
    if(response.ok && res.status === 'success'){
        // code to be write
    }
    else{
        alert("sorry data could not fetched");
    }


    // 4. Real-time Search functionality
    searchInput.addEventListener('input', (e) => {
        const searchTerm = e.target.value.toLowerCase().trim();
        
        const filteredProducts = products.filter(product => {
            return product.name.toLowerCase().includes(searchTerm) || 
                   product.category.toLowerCase().includes(searchTerm);
        });

        renderTable(filteredProducts);
    });

    // 5. Global Action Functions (Attached to window so inline onclick can access them)
    window.editProduct = function(productId) {
        console.log("Edit requested for product ID:", productId);
        // Find the product to show its name in the alert
        const product = products.find(p => p.id === productId);
        alert(`Edit view triggered for: ${product.name}`);
        
        // In a real app, this would trigger a modal or navigate to an edit page:
        // loadDynamicContent('edit-product', { id: productId }); 
    };

    window.deleteProduct = function(productId) {
        const product = products.find(p => p.id === productId);
        const confirmDelete = confirm(`Are you sure you want to delete "${product.name}"?\nThis will remove it from the Vector Search index.`);
        
        if (confirmDelete) {
            // Update the array (mocking a database deletion)
            products = products.filter(p => p.id !== productId);
            
            // Re-render the table with the search filter still applied (if any)
            const searchTerm = searchInput.value.toLowerCase().trim();
            const filteredProducts = products.filter(p => 
                p.name.toLowerCase().includes(searchTerm) || 
                p.category.toLowerCase().includes(searchTerm)
            );
            
            renderTable(filteredProducts);
            
            // In a real app, you would make a fetch() call here:
            // fetch(`/api/products/${productId}`, { method: 'DELETE' })
            // .then(...) 
        }
    };
});
    </script>
</body>
