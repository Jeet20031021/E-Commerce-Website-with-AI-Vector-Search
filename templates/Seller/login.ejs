<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Portal | AI Vector Search E-Commerce</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6',
                            600: '#0d9488',
                            900: '#134e4a',
                            950: '#042f2e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom styles for animations */
        .fade-in { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* AI Node background pattern */
        .bg-pattern {
            background-image: radial-gradient(rgba(255, 255, 255, 0.1) 2px, transparent 2px);
            background-size: 30px 30px;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8 antialiased selection:bg-brand-500 selection:text-white">

    <div class="max-w-5xl w-full bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col md:flex-row relative">
        
        <!-- Left Panel: Branding & AI Theme (Hidden on small mobile, visible md and up) -->
        <div class="hidden md:flex md:w-5/12 bg-gradient-to-br from-gray-900 via-brand-950 to-brand-900 p-10 flex-col justify-between relative overflow-hidden">
            <!-- Decorative background elements -->
            <div class="absolute inset-0 bg-pattern opacity-30"></div>
            <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 rounded-full bg-brand-500 opacity-10 blur-3xl"></div>
            <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-48 h-48 rounded-full bg-blue-500 opacity-20 blur-2xl"></div>

            <div class="relative z-10">
                <div class="flex items-center space-x-2 text-white mb-12">
                    <!-- Brand Icon -->
                    <svg class="w-8 h-8 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
                    </svg>
                    <span class="text-xl font-bold tracking-wider">LuminaCommerce</span>
                </div>
                
                <h1 class="text-3xl lg:text-4xl font-bold text-white leading-tight mb-6">
                    Supercharge your sales with <span class="text-brand-500">AI Vector Search</span>.
                </h1>
                <p class="text-gray-300 text-sm lg:text-base leading-relaxed">
                    Access your seller dashboard to manage inventory, track AI-driven semantic search analytics, and boost your product visibility across our intelligent marketplace.
                </p>
            </div>

            <div class="relative z-10 flex items-center space-x-3 mt-12">
                <div class="flex -space-x-2">
                    <img class="w-8 h-8 rounded-full border-2 border-brand-900" src="https://placehold.co/100x100/333/fff?text=S1" alt="Seller">
                    <img class="w-8 h-8 rounded-full border-2 border-brand-900" src="https://placehold.co/100x100/555/fff?text=S2" alt="Seller">
                    <img class="w-8 h-8 rounded-full border-2 border-brand-900" src="https://placehold.co/100x100/777/fff?text=S3" alt="Seller">
                </div>
                <p class="text-xs text-gray-400 font-medium">Join 10,000+ top-tier sellers.</p>
            </div>
        </div>

        <!-- Right Panel: Login Form -->
        <div class="w-full md:w-7/12 p-8 sm:p-12 lg:p-16">
            
            <div class="mb-8">
                <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Seller Portal</h2>
                <p class="text-gray-500 text-sm">Welcome back! Please enter your credentials to access your dashboard.</p>
            </div>

            <!-- Custom Alert Component -->
            <div id="alert-container" class="hidden mb-6 rounded-lg p-4 fade-in flex items-start" role="alert">
                <div id="alert-icon" class="flex-shrink-0 mr-3 mt-0.5">
                    <!-- Icon injected via JS -->
                </div>
                <div id="alert-message" class="text-sm font-medium"></div>
            </div>

            <form id="seller-login-form" class="space-y-6" novalidate>
                <!-- Email Field -->
                <div>
                    <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5">Business Email</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                            </svg>
                        </div>
                        <input type="email" id="email" name="email" required
                            class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg bg-gray-50 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 focus:bg-white transition-all sm:text-sm"
                            placeholder="seller@company.com">
                    </div>
                </div>

                <!-- Password Field -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="password" class="block text-sm font-semibold text-gray-700">Password</label>
                        <a href="#" class="text-sm font-medium text-brand-600 hover:text-brand-500 transition-colors">Forgot password?</a>
                    </div>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <input type="password" id="password" name="password" required
                            class="block w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg bg-gray-50 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 focus:bg-white transition-all sm:text-sm"
                            placeholder="••••••••">
                        
                        <!-- Toggle Password Visibility -->
                        <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 focus:outline-none">
                            <svg id="eye-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center">
                    <input id="remember-me" name="remember-me" type="checkbox" 
                        class="h-4 w-4 text-brand-600 focus:ring-brand-500 border-gray-300 rounded cursor-pointer transition-colors">
                    <label for="remember-me" class="ml-2 block text-sm text-gray-700 cursor-pointer">
                        Remember my session
                    </label>
                </div>

                <!-- Submit Button -->
                <div>
                    <button type="submit" id="submit-btn"
                        class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors disabled:opacity-70 disabled:cursor-not-allowed">
                        <span>Sign into Seller Dashboard</span>
                        <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </button>
                </div>
            </form>

            <div class="mt-8 text-center sm:text-left">
                <p class="text-sm text-gray-600">
                    Want to sell your products globally? 
                    <a href="/seller/signup" class="font-semibold text-brand-600 hover:text-brand-500 transition-colors">Apply as a Seller</a>
                </p>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('seller-login-form');
            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            const submitBtn = document.getElementById('submit-btn');
            const alertContainer = document.getElementById('alert-container');
            const alertIcon = document.getElementById('alert-icon');
            const alertMessage = document.getElementById('alert-message');
            const togglePasswordBtn = document.getElementById('toggle-password');
            const eyeIcon = document.getElementById('eye-icon');

            // SVG Icons for Alerts
            const icons = {
                error: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>`,
                success: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>`,
                loading: `<svg class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>`
            };

            // Toggle Password Visibility
            togglePasswordBtn.addEventListener('click', () => {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                
                if (type === 'text') {
                    eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>`;
                } else {
                    eyeIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>`;
                }
            });

            // Display Alert Function
            function showAlert(message, type) {
                // Remove existing classes
                alertContainer.className = 'mb-6 rounded-lg p-4 fade-in flex items-start';
                
                if (type === 'error') {
                    alertContainer.classList.add('bg-red-50', 'border', 'border-red-200', 'text-red-800');
                    alertIcon.innerHTML = icons.error;
                    alertIcon.classList.add('text-red-500');
                    alertIcon.classList.remove('text-green-500', 'text-brand-500');
                } else if (type === 'success') {
                    alertContainer.classList.add('bg-green-50', 'border', 'border-green-200', 'text-green-800');
                    alertIcon.innerHTML = icons.success;
                    alertIcon.classList.add('text-green-500');
                    alertIcon.classList.remove('text-red-500', 'text-brand-500');
                } else if (type === 'loading') {
                    alertContainer.classList.add('bg-brand-50', 'border', 'border-brand-200', 'text-brand-800');
                    alertIcon.innerHTML = icons.loading;
                    alertIcon.classList.add('text-brand-500');
                    alertIcon.classList.remove('text-red-500', 'text-green-500');
                }

                alertMessage.textContent = message;
                alertContainer.classList.remove('hidden');
            }

            function hideAlert() {
                alertContainer.classList.add('hidden');
            }

            // Form Submit Handler
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                hideAlert();
                
                const email = emailInput.value.trim();
                const password = passwordInput.value.trim();

                // Validation
                if (!email || !password) {
                    showAlert('Please enter both your business email and password.', 'error');
                    // Shake animation for invalid inputs could be added here
                    return;
                }

                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailRegex.test(email)) {
                    showAlert('Please enter a valid email format (e.g., seller@company.com).', 'error');
                    emailInput.focus();
                    return;
                }

                

                // Simulate UI state during API Call
                submitBtn.disabled = true;
                submitBtn.innerHTML = `
                    <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    Authenticating...
                `;
                
                showAlert('Verifying seller credentials...', 'loading');

               const response = await fetch("/seller/login/submit", {
                method: "POST",
                body: JSON.stringify({email:email, password: password}),
                headers: {
                    "Content-Type": "application/json",
                }
               });

               const res = await response.json();
               if(response.ok && res.status === 'success'){
                 // Simulate Network Request Delay
                setTimeout(() => {
                    // For UI demonstration, let's pretend success
                    showAlert('Authentication successful! Redirecting to dashboard...', 'success');
                    submitBtn.innerHTML = `
                        <span>Sign into Seller Dashboard</span>
                        <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    `;

                    window.location.href = '/seller/dashboard';
                    
                }, 1000);
               }
               else{
                showAlert(res.message, 'error');
                submitBtn.disabled = false;
                 submitBtn.innerHTML = `<span>Sign into Seller Dashboard</span>...`;
               }
            });
            
            // Clear alerts on typing
            emailInput.addEventListener('input', hideAlert);
            passwordInput.addEventListener('input', hideAlert);
        });
    </script>
</body>
</html>